{% extends "adminbase.html.twig" %}

{% block title %}
    Kérdőívek - Webmenza
{% endblock title %}

{% block headtitle %}
    Kérdőívek
{% endblock headtitle %}

{% block content %}
<div class="d-flex justify-content-sm-between flex-wrap">
    <div><a href="add.survey.php" class="btn btn-primary" role="button"><i class="bi bi-calendar-plus"></i> Kérdőív létrehozása</a></div>
</div>
<h2>Futó kérdőívek</h2>
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Cím</th>
                <th>Határidő eleje</th>
                <th>Határidő vége</th>
                <th>Anonim</th>
                <th>Műveletek</th>
            </tr>
        </thead>
        <tbody>
            {% for survey in active %}
            <tr>
                <td>{{ survey.title }}</td>
                <td>{{ survey.start|date("Y. m. d.") }}</td>
                <td>{{ survey.end|date("Y. m. d.") }}</td>
                <td>{{ survey.anonim ? "igen" : "nem" }}</td>
                <td>
                    <a href="edit.survey.php?id={{ survey.id|e }}" class="btn btn-primary" role="button"><i class="bi bi-pencil-square"></i> Szerkesztés</a>
                    <a href="delete.survey.php?id={{ survey.id|e }}" class="btn btn-danger" role="button"><i class="bi bi-trash3"></i> Törlés</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
<h2>Közelgő kérdőívek</h2>
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Cím</th>
                <th>Határidő eleje</th>
                <th>Határidő vége</th>
                <th>Anonim</th>
                <th>Műveletek</th>
            </tr>
        </thead>
        <tbody>
            {% for survey in upcoming %}
            <tr>
                <td>{{ survey.title }}</td>
                <td>{{ survey.start|date("Y. m. d.") }}</td>
                <td>{{ survey.end|date("Y. m. d.") }}</td>
                <td>{{ survey.anonim ? "igen" : "nem" }}</td>
                <td>
                    <a href="edit.survey.php?id={{ survey.id|e }}" class="btn btn-primary" role="button"><i class="bi bi-pencil-square"></i> Szerkesztés</a>
                    <a href="delete.survey.php?id={{ survey.id|e }}" class="btn btn-danger" role="button"><i class="bi bi-trash3"></i> Törlés</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
<h2>Lejárt kérdőívek</h2>
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Cím</th>
                <th>Határidő eleje</th>
                <th>Határidő vége</th>
                <th>Anonim</th>
                <th>Műveletek</th>
            </tr>
        </thead>
        <tbody>
            {% for survey in expired %}
            <tr>
                <td>{{ survey.title }}</td>
                <td>{{ survey.start|date("Y. m. d.") }}</td>
                <td>{{ survey.end|date("Y. m. d.") }}</td>
                <td>{{ survey.anonim ? "igen" : "nem" }}</td>
                <td>
                    <a href="edit.survey.php?id={{ survey.id|e }}" class="btn btn-primary" role="button"><i class="bi bi-pencil-square"></i> Szerkesztés</a>
                    <a href="delete.survey.php?id={{ survey.id|e }}" class="btn btn-danger" role="button"><i class="bi bi-trash3"></i> Törlés</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock content %}