{% extends "adminbase.html.twig" %}

{% block title %}
    {{ diet[0]|escape }} étrend szerkesztése - Webmenza
{% endblock title %}

{% block headtitle %}
    {{ diet[0]|escape }} étrend szerkesztése
{% endblock headtitle %}

{% block content %}
<form method="post" action="#">
    <div class="mb-3 row">
        <label for="name" class="form-label col-sm-2">Étrend megnevezése:</label>
        <input type="text" name="name" id="name" class="form-control col" required value="{{ diet[0]|escape }}">
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Mentés</button>
</form>
{% endblock content %}