{% extends "adminbase.html.twig" %}

{% block title %}
    Menü hozzáadása - Webmenza
{% endblock title %}

{% block headtitle %}
    Menü hozzáadása
{% endblock headtitle %}

{% block content %}
<form method="post" action="#">
    <div class="mb-3 row">
        <label for="date" class="form-label col-sm-2">Nap:</label>
        <input type="date" name="date" id="date" class="form-control col" required>
    </div>
    <div class="mb-3 row">
        <label for="menu" class="form-label col-sm-2">Menü:</label>
        <textarea name="menu" id="menu" required class="form-control col"></textarea>
    </div>
    <div class="mb-3 row">
        <label for="diets" class="form-label col-sm-2">Étrend:</label>
        <div id="diets" class="col">
            {% for diet in diets %}
            <div class="form-check form-check-inline">
                <input type="checkbox" name="diets[]" id="diet{{diet['id']}}" value="{{diet['id']}}" class="form-check-input">
                <label for="diet{{diet['id']}}" class="form-check-label">{{diet['name']}}</label>
            </div>
            {% endfor %}
        </div>
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Mentés</button>
</form>
{% endblock content %}