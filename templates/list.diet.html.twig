{% extends "adminbase.html.twig" %}

{% block title %}
    Étrendek - Webmenza
{% endblock title %}

{% block headtitle %}
    Étrendek
{% endblock headtitle %}

{% block content %}
<div class="d-flex justify-content-sm-between flex-wrap">
<div><a href="add.diet.php" class="btn btn-primary" role="button"><i class="bi bi-plus-lg"></i> Étrend létrehozása</a></div>
</div>
<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Név</th>
                <th>Műveletek</th>
            </tr>
        </thead>
        <tbody>
            {% for diet in diets %}
            <tr>
                <td>{{ diet[1] }}</td>
                <td>
                    <a href="edit.diet.php?id={{ diet[0] }}" class="btn btn-primary" role="button"><i class="bi bi-pencil-square"></i> Szerkesztés</a>
                    <a href="delete.diet.php?id={{ diet[0] }}" class="btn btn-danger" role="button"><i class="bi bi-trash3"></i> Törlés</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock content %}