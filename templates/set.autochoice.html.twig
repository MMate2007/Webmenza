{% extends "base.html.twig" %}

{% block title %}
    Automata kitöltés beállításai - Webmenza
{% endblock title %}

{% block headtitle %}
    Automata kitöltés beállításai
{% endblock headtitle %}

{% block script %}
<script>
    function resetform() {
        document.querySelectorAll('input:checked').forEach(a => {a.checked = false});
        document.querySelector("#reset").value = 1;
        document.querySelector("form").submit();
    }
</script>
{% endblock %}

{% block content %}
<p>Az alábbiakban megadhatot, hogy ha nem töltöd ki a menzaigénylést, akkor a rendszer mit tegyen. A rendszer képes rögzíteni, hogy egy adott napon nem kérsz ebédet, vagy akár választhat véletszerűen a menük közül.<br><b>Ha már egy adott napra rögzítettél valamit, akkor az nem kerül felülírásra!</b></p>
<p><b>Fontos! Előfordulhat, hogy a rendszer üzemeltetője nem állítja be a folyamat automatikus futtatását. Ez azt jelenti, hogy ez a funkció nem garantálja a biztos kitöltést!</b></p>
<form action="#" method="post">
    <div class="mb-3 row align-items-center">
        <label class="col-2">Hétfő:</label>
        <div class="btn-group col" role="group" aria-label="Hétfő">
            <input type="radio" class="btn-check" name="d0" id="d00" autocomplete="off" value=0 {{ (settings[0] is same as 0) ? "checked" }}>
            <label class="btn btn-outline-danger" for="d00">Nem kérek</label>
            <input type="radio" class="btn-check" name="d0" id="d01" autocomplete="off" value=1 {{ (settings[0] is same as 1) ? "checked" }}>
            <label class="btn btn-outline-success" for="d01">Véletlenszerű</label>
        </div>
    </div>
    <div class="mb-3 row align-items-center">
        <label class="col-2">Kedd:</label>
        <div class="btn-group col" role="group" aria-label="Kedd">
            <input type="radio" class="btn-check" name="d1" id="d10" autocomplete="off" value=0 {{ (settings[1] is same as 0) ? "checked" }}>
            <label class="btn btn-outline-danger" for="d10">Nem kérek</label>
            <input type="radio" class="btn-check" name="d1" id="d11" autocomplete="off" value=1 {{ (settings[1] is same as 1) ? "checked" }}>
            <label class="btn btn-outline-success" for="d11">Véletlenszerű</label>
        </div>
    </div>
    <div class="mb-3 row align-items-center">
        <label class="col-2">Szerda:</label>
        <div class="btn-group col" role="group" aria-label="Szerda">
            <input type="radio" class="btn-check" name="d2" id="d20" autocomplete="off" value=0 {{ (settings[2] is same as 0) ? "checked" }}>
            <label class="btn btn-outline-danger" for="d20">Nem kérek</label>
            <input type="radio" class="btn-check" name="d2" id="d21" autocomplete="off" value=1 {{ (settings[2] is same as 1) ? "checked" }}>
            <label class="btn btn-outline-success" for="d21">Véletlenszerű</label>
        </div>
    </div>
    <div class="mb-3 row align-items-center">
        <label class="col-2">Csütörtök:</label>
        <div class="btn-group col" role="group" aria-label="Csütörtök">
            <input type="radio" class="btn-check" name="d3" id="d30" autocomplete="off" value=0 {{ (settings[3] is same as 0) ? "checked" }}>
            <label class="btn btn-outline-danger" for="d30">Nem kérek</label>
            <input type="radio" class="btn-check" name="d3" id="d31" autocomplete="off" value=1 {{ (settings[3] is same as 1) ? "checked" }}>
            <label class="btn btn-outline-success" for="d31">Véletlenszerű</label>
        </div>
    </div>
    <div class="mb-3 row align-items-center">
        <label class="col-2">Péntek:</label>
        <div class="btn-group col" role="group" aria-label="Péntek">
            <input type="radio" class="btn-check" name="d4" id="d40" autocomplete="off" value=0 {{ (settings[4] is same as 0) ? "checked" }}>
            <label class="btn btn-outline-danger" for="d40">Nem kérek</label>
            <input type="radio" class="btn-check" name="d4" id="d41" autocomplete="off" value=1 {{ (settings[4] is same as 1) ? "checked" }}>
            <label class="btn btn-outline-success" for="d41">Véletlenszerű</label>
        </div>
    </div>
    <div class="mb-3 row align-items-center">
        <label class="col-2">Szombat:</label>
        <div class="btn-group col" role="group" aria-label="Szombat">
            <input type="radio" class="btn-check" name="d5" id="d50" autocomplete="off" value=0 {{ (settings[5] is same as 0) ? "checked" }}>
            <label class="btn btn-outline-danger" for="d50">Nem kérek</label>
            <input type="radio" class="btn-check" name="d5" id="d51" autocomplete="off" value=1 {{ (settings[5] is same as 1) ? "checked" }}>
            <label class="btn btn-outline-success" for="d51">Véletlenszerű</label>
        </div>
    </div>
    <input type="hidden" name="reset" id="reset" value="0">
    <button type="submit" class="btn btn-primary"><i class="bi bi-floppy"></i> Mentés</button>
    <button type="button" class="btn btn-outline-danger" onclick="resetform()">Kikapcsolás</button>
</form>
<h3>Futtatás most</h3>
<p>Lehetőséged van az automata kitöltő algoritmust most rögtön is futtatni a lent meghatározott időszakra.</p>
{% endblock content %}